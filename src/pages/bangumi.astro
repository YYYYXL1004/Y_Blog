---
import BangumiPanel from "@components/BangumiPanel.svelte";
import data from "@/data/bangumi/anime-collections.json";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import type { BangumiDataset } from "@/types/bangumi";

const dataset = data as BangumiDataset;
---

<MainGridLayout title={i18n(I18nKey.bangumi)} description={i18n(I18nKey.bangumi)}>
	<BangumiPanel dataset={dataset} client:only="svelte" />
</MainGridLayout>
