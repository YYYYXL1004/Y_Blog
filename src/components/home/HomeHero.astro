---
import { url } from "../../utils/url-utils";

interface Props {
	image: string;
}

const { image } = Astro.props;
const quote = "内心丰盈者，独行也从众";
const quoteChars = Array.from(quote);
---

<section
	id="home-hero"
	class="relative isolate min-h-[100svh] overflow-hidden"
	style={`background-image: url(${url(image)});`}
>
	<div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(120,198,255,0.24),transparent_34%)]"></div>
	<div class="absolute inset-0 bg-black/[0.12]"></div>
	<div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(4,9,18,0.03)_0%,rgba(4,9,18,0.12)_48%,rgba(4,9,18,0.48)_100%)]"></div>

	<div class="relative z-10 mx-auto flex min-h-[100svh] max-w-[var(--page-width)] items-center justify-center px-6 py-28 md:px-8">
		<p
			aria-label={quote}
			class="max-w-4xl text-balance text-center text-3xl font-semibold leading-[1.8] tracking-[0.12em] text-white/[0.94] drop-shadow-[0_12px_36px_rgba(0,0,0,0.26)] sm:text-4xl md:text-5xl md:leading-[1.9]"
		>
			<span class="sr-only">{quote}</span>
			<span aria-hidden="true" class="inline-flex flex-wrap justify-center gap-x-[0.08em] gap-y-[0.16em]">
				{quoteChars.map((char, index) => (
					<span
						class="hero-quote-char inline-block"
						style={`--hero-char-delay: ${index * 90}ms;`}
					>
						{char}
					</span>
				))}
			</span>
		</p>
	</div>
</section>

<style>
	#home-hero {
		background-position: center;
		background-repeat: no-repeat;
		background-size: cover;
	}

	@media (max-width: 767px) {
		#home-hero {
			background-position: center top;
		}
	}

	.hero-quote-char {
		opacity: 0;
		transform: translateY(0.8em) scale(0.78);
		filter: blur(0.35rem);
		animation: hero-quote-pop 720ms cubic-bezier(0.2, 0.9, 0.22, 1.24) forwards;
		animation-delay: calc(180ms + var(--hero-char-delay));
		will-change: transform, opacity, filter;
	}

	@keyframes hero-quote-pop {
		0% {
			opacity: 0;
			transform: translateY(0.8em) scale(0.78);
			filter: blur(0.35rem);
		}

		62% {
			opacity: 1;
			transform: translateY(-0.14em) scale(1.08);
			filter: blur(0);
		}

		100% {
			opacity: 1;
			transform: translateY(0) scale(1);
			filter: blur(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-quote-char {
			opacity: 1;
			transform: none;
			filter: none;
			animation: none;
		}
	}
</style>
