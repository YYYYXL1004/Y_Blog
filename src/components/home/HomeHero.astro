---
import { url } from "../../utils/url-utils";

interface Props {
	image: string;
}

const { image } = Astro.props;
const quote = "内心丰盈者，独行也从众";
const quoteChars = Array.from(quote);
---

<section
	id="home-hero"
	class="relative isolate min-h-[100svh] overflow-hidden"
	style={`background-image: url(${url(image)});`}
>
	<div class="home-hero-orb absolute inset-0"></div>
	<div class="home-hero-overlay absolute inset-0"></div>
	<div class="home-hero-gradient absolute inset-0"></div>

	<div class="relative z-10 mx-auto flex min-h-[100svh] max-w-[var(--page-width)] items-center justify-center px-4 py-24 sm:px-6 sm:py-28 md:px-8">
		<p
			aria-label={quote}
			class="home-hero-quote max-w-4xl text-balance text-center text-2xl font-semibold leading-[1.65] tracking-[0.08em] sm:text-4xl sm:leading-[1.8] sm:tracking-[0.12em] md:text-5xl md:leading-[1.9]"
		>
			<span class="sr-only">{quote}</span>
			<span aria-hidden="true" class="inline-flex flex-wrap justify-center gap-x-[0.04em] gap-y-[0.12em] sm:gap-x-[0.08em] sm:gap-y-[0.16em]">
				{quoteChars.map((char, index) => (
					<span
						class="hero-quote-char inline-block"
						style={`--hero-char-delay: ${index * 90}ms;`}
					>
						{char}
					</span>
				))}
			</span>
		</p>
	</div>
</section>

<style>
	#home-hero {
		background-position: center;
		background-repeat: no-repeat;
		background-size: cover;
	}

	@media (max-width: 767px) {
		#home-hero {
			background-position: center top;
		}
	}

	.hero-quote-char {
		opacity: 0;
		transform: translateY(0.8em) scale(0.78);
		filter: blur(0.35rem);
		animation: hero-quote-pop 720ms cubic-bezier(0.2, 0.9, 0.22, 1.24) forwards;
		animation-delay: calc(180ms + var(--hero-char-delay));
		will-change: transform, opacity, filter;
	}

	@keyframes hero-quote-pop {
		0% {
			opacity: 0;
			transform: translateY(0.8em) scale(0.78);
			filter: blur(0.35rem);
		}

		62% {
			opacity: 1;
			transform: translateY(-0.14em) scale(1.08);
			filter: blur(0);
		}

		100% {
			opacity: 1;
			transform: translateY(0) scale(1);
			filter: blur(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-quote-char {
			opacity: 1;
			transform: none;
			filter: none;
			animation: none;
		}
	}

	.home-hero-orb {
		background: radial-gradient(circle at top left, rgba(110, 190, 255, 0.18), transparent 36%);
	}

	.home-hero-overlay {
		background: linear-gradient(180deg, rgba(255, 255, 255, 0.08) 0%, rgba(255, 255, 255, 0.12) 36%, rgba(9, 16, 30, 0.18) 100%);
	}

	.home-hero-gradient {
		background: linear-gradient(180deg, rgba(255, 255, 255, 0.04) 0%, rgba(18, 30, 52, 0.1) 52%, rgba(18, 30, 52, 0.3) 100%);
	}

	.home-hero-quote {
		color: rgba(255, 255, 255, 0.96);
		text-shadow: 0 12px 34px rgba(15, 23, 42, 0.18), 0 1px 0 rgba(15, 23, 42, 0.18);
	}

	:root.dark .home-hero-orb {
		background: radial-gradient(circle at top left, rgba(120, 198, 255, 0.24), transparent 34%);
	}

	:root.dark .home-hero-overlay {
		background: rgba(0, 0, 0, 0.12);
	}

	:root.dark .home-hero-gradient {
		background: linear-gradient(180deg, rgba(10, 16, 28, 0.03) 0%, rgba(10, 16, 28, 0.12) 48%, rgba(10, 16, 28, 0.48) 100%);
	}

	:root.dark .home-hero-quote {
		color: rgba(255, 255, 255, 0.94);
		text-shadow: 0 12px 36px rgba(0, 0, 0, 0.26);
	}
</style>
