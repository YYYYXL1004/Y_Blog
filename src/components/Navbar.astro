---
import { Icon } from "astro-icon/components";
import { navBarConfig, profileConfig, siteConfig } from "../config";
import { LinkPresets } from "../constants/link-presets";
import { LinkPreset, type NavBarLink } from "../types/config";
import { url } from "../utils/url-utils";
import LightDarkSwitch from "./LightDarkSwitch.svelte";
import Search from "./Search.svelte";
import DisplaySettings from "./widget/DisplaySettings.svelte";
import NavMenuPanel from "./widget/NavMenuPanel.astro";

interface Props {
	class?: string;
	floating?: boolean;
}

const className = Astro.props.class;
const floating = Astro.props.floating ?? false;

const links: NavBarLink[] = navBarConfig.links.map(
	(item: NavBarLink | LinkPreset): NavBarLink => {
		if (typeof item === "number") {
			return LinkPresets[item];
		}
		return item;
	},
);
---

<div id="navbar" class:list={["z-50 onload-animation relative", { "home-navbar": floating, "page-navbar": !floating }]} data-floating={floating ? "true" : "false"}>

    <div
        data-navbar-surface
        data-scrolled="false"
        class:list={[
            className,
            floating
                ? "home-nav-surface mx-auto flex min-h-[4.5rem] items-center justify-between gap-3 rounded-[2rem] border px-3 py-3"
                : "site-nav-surface mx-auto flex min-h-[4.5rem] items-center justify-between gap-3 rounded-[2rem] border px-3 py-3",
        ]}
    >
        <a
            href={url("/")}
            class:list={[
                "rounded-full active:scale-95",
                floating
                    ? "home-nav-brand inline-flex items-center gap-3 rounded-full px-2 py-1.5 transition"
                    : "inline-flex items-center gap-3 px-2 py-1.5 text-[var(--shell-text)] transition hover:text-[var(--shell-text)]",
            ]}
        >
            <img
                src={url(profileConfig.avatar || "/images/avatar-y.svg")}
                alt={profileConfig.name}
                class:list={[
                    "h-11 w-11 rounded-full object-cover",
                    floating
                        ? "home-nav-avatar"
                        : "border border-[var(--surface-border-strong)] shadow-[0_0_0_3px_var(--shell-nav-bg)]",
                ]}
            />
            <div class="hidden min-w-0 md:block">
                <div class:list={[
                    "truncate text-sm font-semibold tracking-[0.16em]",
                    floating ? "home-nav-title" : "text-[var(--shell-text)]",
                ]}>
                    {profileConfig.name}
                </div>
                <div class:list={[
                    "truncate text-[0.68rem] uppercase tracking-[0.26em]",
                    floating ? "home-nav-subtitle" : "text-[var(--shell-text-soft)]",
                ]}>
                    {siteConfig.subtitle}
                </div>
            </div>
        </a>

        <div class:list={[
            "hidden md:flex items-center",
            {
                "gap-1 lg:gap-2": floating,
            },
        ]}>
            {links.map((l) => {
                return (
                    <a
                        aria-label={l.name}
                        href={l.external ? l.url : url(l.url)}
                        target={l.external ? "_blank" : null}
                        class:list={[
                            floating
                                ? "home-nav-link rounded-full px-4 py-2 text-sm font-semibold transition active:scale-95"
                                : "rounded-full px-4 py-2 text-sm font-semibold text-[var(--shell-text)] transition hover:bg-[var(--shell-input-bg)] hover:text-[var(--primary)] active:scale-95",
                        ]}
                    >
                        <div class="flex items-center">
                            {l.name}
                            {l.external && (
                                <Icon
                                    name="fa6-solid:arrow-up-right-from-square"
                                    class:list={[
                                        "text-[0.875rem] transition -translate-y-[1px] ml-1",
                                        floating ? "home-nav-link-icon" : "text-25",
                                    ]}
                                ></Icon>
                            )}
                        </div>
                    </a>
                );
            })}
        </div>

        <div class="flex items-center">
            <Search client:only="svelte"></Search>
            {!siteConfig.themeColor.fixed && !floating && (
                <button aria-label="Display Settings" class="btn-plain scale-animation rounded-lg h-11 w-11 active:scale-90" id="display-settings-switch">
                    <Icon name="material-symbols:palette-outline" class="text-[1.25rem]"></Icon>
                </button>
            )}
            {/* astro check mis-types this Svelte client directive; build/runtime are valid */}
            {/* @ts-expect-error astro client directive typing */}
            <LightDarkSwitch client:only="svelte"></LightDarkSwitch>
            <button
                aria-label="Menu"
                name="Nav Menu"
                class:list={[
                    floating
                        ? "btn-plain home-nav-icon-btn scale-animation rounded-full active:scale-90"
                        : "rounded-full text-[var(--shell-text)] transition hover:bg-[var(--shell-input-bg)] hover:text-[var(--primary)] active:scale-90",
                    "w-11 h-11 md:!hidden",
                ]}
                id="nav-menu-switch"
            >
                <Icon name="material-symbols:menu-rounded" class="text-[1.25rem]"></Icon>
            </button>
        </div>

        <NavMenuPanel links={links}></NavMenuPanel>
        {!siteConfig.themeColor.fixed && !floating && <DisplaySettings client:only="svelte"></DisplaySettings>}
    </div>
</div>

<script>
function loadButtonScript() {
    let settingBtn = document.getElementById("display-settings-switch");
    if (settingBtn) {
        settingBtn.onclick = function () {
            let settingPanel = document.getElementById("display-setting");
            if (settingPanel) {
                settingPanel.classList.toggle("float-panel-closed");
            }
        };
    }

    let menuBtn = document.getElementById("nav-menu-switch");
    if (menuBtn) {
        menuBtn.onclick = function () {
            let menuPanel = document.getElementById("nav-menu-panel");
            if (menuPanel) {
                menuPanel.classList.toggle("float-panel-closed");
            }
        };
    }
}

function syncFloatingNavbar() {
    const navbar = document.querySelector('#navbar[data-floating="true"] [data-navbar-surface]');
    if (!(navbar instanceof HTMLElement)) {
        return;
    }
    const threshold = Math.max(72, window.innerHeight * 0.12);
    navbar.dataset.scrolled = window.scrollY > threshold ? "true" : "false";
}

if (!document.documentElement.dataset.yyxlFloatingNavbarBound) {
    window.addEventListener("scroll", syncFloatingNavbar, { passive: true });
    window.addEventListener("resize", syncFloatingNavbar);
    document.documentElement.dataset.yyxlFloatingNavbarBound = "true";
}

loadButtonScript();
syncFloatingNavbar();
</script>

{import.meta.env.PROD && <script is:inline define:vars={{scriptUrl: url('/pagefind/pagefind.js')}}>
async function loadPagefind() {
    try {
        const response = await fetch(scriptUrl, { method: 'HEAD' });
        if (!response.ok) {
            throw new Error(`Pagefind script not found: ${response.status}`);
        }

        const pagefind = await import(scriptUrl);

        await pagefind.options({
            excerptLength: 20
        });

        window.pagefind = pagefind;

        document.dispatchEvent(new CustomEvent('pagefindready'));
        console.log('Pagefind loaded and initialized successfully, event dispatched.');
    } catch (error) {
        console.error('Failed to load Pagefind:', error);
        window.pagefind = {
            search: () => Promise.resolve({ results: [] }),
            options: () => Promise.resolve(),
        };
        document.dispatchEvent(new CustomEvent('pagefindloaderror'));
        console.log('Pagefind load error, event dispatched.');
    }
}

if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', loadPagefind);
} else {
    loadPagefind();
}
</script>}
